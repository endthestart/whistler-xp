#!/usr/bin/env python3
"""Put the desktop icons in Windows XP order (run once at first login)."""
import os
import signal
import subprocess
import time

import yaml

CONF = os.path.expanduser("~/.config/xfce4/desktop/icons.screen0.yaml")
ORDER = ["My Documents", "My Computer", "My Network Places", "trash:///", "Mozilla Firefox",
         "Wine Center", "Install Whistler XP"]


def key_for(name, desk):
    return name if "://" in name else os.path.join(desk, name + ".desktop")


def main():
    desk = subprocess.run(["xdg-user-dir", "DESKTOP"], capture_output=True, text=True).stdout.strip()
    wanted = [key_for(n, desk) for n in ORDER if "://" in n or os.path.exists(key_for(n, desk))]
    data = None
    for _ in range(40):
        try:
            with open(CONF) as f:
                data = yaml.safe_load(f)
            icons = data["configs"][0]["icons"]
            if all(k in icons for k in wanted):
                break
        except (OSError, KeyError, IndexError, TypeError, yaml.YAMLError):
            pass
        time.sleep(1)
    if not data:
        return
    pids = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "xfdesktop"], capture_output=True,
                          text=True).stdout.split()
    for pid in pids:
        os.kill(int(pid), signal.SIGSTOP)
    for cfg in data.get("configs", []):
        icons = cfg.setdefault("icons", {})
        row = 0
        for k in wanted:
            icons[k] = {"row": row, "col": 0}
            row += 1
        for k in sorted(set(icons) - set(wanted)):
            icons[k] = {"row": row % 7, "col": 1 + row // 7}
            row += 1
    with open(CONF, "w") as f:
        f.write("#\n# DO NOT EDIT THIS FILE WHILE XFDESKTOP IS RUNNING\n#\n")
        yaml.safe_dump(data, f, sort_keys=False)
    for pid in pids:
        os.kill(int(pid), signal.SIGKILL)
    time.sleep(2)
    if not subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "xfdesktop"]).returncode == 0:
        subprocess.Popen(["xfdesktop"], start_new_session=True)


if __name__ == "__main__":
    main()
