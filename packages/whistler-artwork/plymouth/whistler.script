// Whistler boot screen: logo, three blue blocks sliding through a rounded box.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Math.Int(sw / 2 - logo.image.GetWidth() / 2);
logo.y = Math.Int(sh / 2 - logo.image.GetHeight() / 2 - sh * 0.06);
logo.sprite.SetPosition(logo.x, logo.y, 1);

box.image = Image("progress-box.png");
box.sprite = Sprite(box.image);
box.x = Math.Int(sw / 2 - box.image.GetWidth() / 2);
box.y = Math.Int(logo.y + logo.image.GetHeight() + sh * 0.07);
box.sprite.SetPosition(box.x, box.y, 1);

block.image = Image("progress-block.png");
for (i = 0; i < 3; i++) {
    blocks[i] = Sprite(block.image);
    blocks[i].SetZ(2);
}

copyright.image = Image("copyright.png");
copyright.sprite = Sprite(copyright.image);
copyright.sprite.SetPosition(Math.Int(sw * 0.03), Math.Int(sh - sh * 0.05 - copyright.image.GetHeight()), 1);
vendor.image = Image("vendor.png");
vendor.sprite = Sprite(vendor.image);
vendor.sprite.SetPosition(Math.Int(sw * 0.97 - vendor.image.GetWidth()), Math.Int(sh - sh * 0.05 - vendor.image.GetHeight()), 1);

inner_left = box.x + 3;
inner_width = box.image.GetWidth() - 6;
step = 0;

fun refresh_callback() {
    step++;
    travel = inner_width + 3 * 10;
    offset = (Math.Int(step / 2) * 2) % travel;
    for (i = 0; i < 3; i++) {
        x = inner_left + offset - 30 + i * 10;
        if (x < inner_left || x > inner_left + inner_width - 8)
            blocks[i].SetOpacity(0);
        else
            blocks[i].SetOpacity(1);
        blocks[i].SetPosition(x, box.y + 4, 2);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// --- passphrase prompt (encrypted disks) ---
prompt.image = Image("prompt.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

fun display_password_callback(prompt_text, bullets) {
    prompt.sprite = Sprite(prompt.image);
    px = Math.Int(sw / 2 - entry.image.GetWidth() / 2);
    py = Math.Int(box.y + sh * 0.08);
    prompt.sprite.SetPosition(px, py, 3);
    entry.sprite = Sprite(entry.image);
    entry.sprite.SetPosition(px, py + prompt.image.GetHeight() + 6, 3);
    for (i = 0; i < 40; i++) {
        if (bullet_sprites[i])
            bullet_sprites[i].SetOpacity(0);
    }
    for (i = 0; i < bullets && i < 40; i++) {
        bullet_sprites[i] = Sprite(bullet.image);
        bullet_sprites[i].SetPosition(px + 6 + i * 12, py + prompt.image.GetHeight() + 13, 4);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    if (prompt.sprite) prompt.sprite.SetOpacity(0);
    if (entry.sprite) entry.sprite.SetOpacity(0);
    for (i = 0; i < 40; i++) {
        if (bullet_sprites[i]) bullet_sprites[i].SetOpacity(0);
    }
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

message_sprite = Sprite();
fun message_callback(text) {
    message_sprite.SetImage(Image.Text(text, 0.8, 0.8, 0.8));
    message_sprite.SetPosition(Math.Int(sw / 2 - message_sprite.GetImage().GetWidth() / 2), Math.Int(sh * 0.85), 5);
}
Plymouth.SetMessageFunction(message_callback);
