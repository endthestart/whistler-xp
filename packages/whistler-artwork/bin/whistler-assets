#!/usr/bin/env python3
"""Manage which artwork Whistler XP shows.

The themes read every swappable file (theme bitmaps, window frame, taskbar,
wallpaper, sounds, UI fonts) through /usr/share/whistler/assets/current, a
tree of symlinks rebuilt by `whistler-assets refresh`:

  /usr/share/whistler/assets/lookalike   original artwork shipped with Whistler
  /var/lib/whistler/originals/assets     optional files imported from the
                                         user's own Windows XP media
For each file the imported original wins when present, otherwise the
lookalike is used, so removing the imported files restores the lookalikes.

usage: whistler-assets refresh | status
"""
import os
import shutil
import subprocess
import sys

LOOK = "/usr/share/whistler/assets/lookalike"
ORIG = os.environ.get("WHISTLER_ORIGINALS", "/var/lib/whistler/originals/assets")
CUR = "/usr/share/whistler/assets/current"


def files(root):
    out = set()
    if not os.path.isdir(root):
        return out
    for d, dirs, names in os.walk(root, followlinks=True):
        for n in names:
            out.add(os.path.relpath(os.path.join(d, n), root))
    return out


def refresh():
    look, orig = files(LOOK), files(ORIG)
    new = CUR + ".new"
    shutil.rmtree(new, ignore_errors=True)
    for rel in sorted(look | orig):
        src = os.path.join(ORIG, rel) if rel in orig else os.path.join(LOOK, rel)
        dst = os.path.join(new, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        os.symlink(src, dst)
    old = CUR + ".old"
    shutil.rmtree(old, ignore_errors=True)
    if os.path.lexists(CUR):
        os.rename(CUR, old)
    os.rename(new, CUR)
    shutil.rmtree(old, ignore_errors=True)
    with open(os.path.join(CUR, ".source"), "w") as f:
        f.write("originals\n" if orig else "lookalike\n")
    if shutil.which("fc-cache"):
        subprocess.run(["fc-cache", "-f"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("whistler-assets: %d files (%d imported originals)" % (len(look | orig), len(orig)))


def status():
    orig = files(ORIG)
    print("lookalike files:", len(files(LOOK)))
    print("imported originals:", len(orig))
    for top in sorted({r.split(os.sep)[0] for r in orig}):
        print("  %-10s %d" % (top, sum(1 for r in orig if r.startswith(top + os.sep))))


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "refresh":
        if os.geteuid() != 0:
            sys.exit("whistler-assets refresh must run as root")
        refresh()
    elif cmd == "status":
        status()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
